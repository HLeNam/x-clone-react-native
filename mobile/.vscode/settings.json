{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    // "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "cSpell.words": ["nativewind"],
  "tailwindCSS.classAttributes": ["class", "className", "headerClassName"],
  "files.associations": {
    "*.css": "tailwindcss",
    "*.scss": "tailwindcss",
    "*.less": "tailwindcss"
  },
  "tailwindCSS.experimental.classRegex": ["[a-zA-Z]*class[a-zA-Z]*='([^']+)'"],
  "colorize.languages": [
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
    // ...
  ]
}
